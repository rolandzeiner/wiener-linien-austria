{
  "entity": {
    "binary_sensor": {
      "stale": {
        "default": "mdi:cloud-off-outline",
        "state": {
          "off": "mdi:cloud-check-outline"
        }
      },
      "route_at_risk": {
        "default": "mdi:transit-transfer",
        "state": {
          "on": "mdi:alert-circle-outline"
        }
      },
      "route_leave_now": {
        "default": "mdi:walk",
        "state": {
          "on": "mdi:run-fast"
        }
      }
    },
    "sensor": {
      "stop": {
        "default": "mdi:train-variant"
      },
      "route": {
        "default": "mdi:routes"
      }
    }
  },
  "services": {
    "plan_trip": {
      "service": "mdi:map-marker-path"
    }
  }
}
