{
  "name": "wiener-linien-austria-card",
  "private": true,
  "version": "0.0.0",
  "description": "Lovelace custom cards for the Wiener Linien Austria HA integration",
  "type": "module",
  "scripts": {
    "build": "rolldown -c",
    "dev": "rolldown -c -w",
    "build:push": "./scripts/dev-push.sh --quiet",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=text --coverage.reporter=json --coverage.include=src/**/*.ts --coverage.exclude=src/**/*.test.ts",
    "test:coverage:gate": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=text --coverage.reporter=json --coverage.include=src/**/*.ts --coverage.exclude=src/**/*.test.ts --coverage.thresholds.statements=55 --coverage.thresholds.branches=47 --coverage.thresholds.functions=51 --coverage.thresholds.lines=57"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.11",
    "happy-dom": "20.14.0",
    "rolldown": "1.2.7",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "lit": "^3.3.3",
    "qr-creator": "1.0.0"
  }
}
