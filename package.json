{
  "name": "wiener-linien-austria-card",
  "version": "0.0.0",
  "private": true,
  "description": "Lovelace custom cards for the Wiener Linien Austria HA integration",
  "type": "module",
  "scripts": {
    "build": "vp build",
    "dev": "vp build --watch --mode development",
    "build:push": "./scripts/dev-push.sh --quiet",
    "test": "vp test run",
    "test:coverage": "vp test run --coverage --coverage.provider=v8 --coverage.reporter=text --coverage.reporter=json --coverage.include=src/**/*.ts --coverage.include=scripts/**/*.mjs --coverage.exclude=src/**/*.test.ts",
    "test:coverage:gate": "vp test run --coverage --coverage.provider=v8 --coverage.reporter=text --coverage.reporter=json --coverage.include=src/**/*.ts --coverage.include=scripts/**/*.mjs --coverage.exclude=src/**/*.test.ts --coverage.thresholds.statements=83 --coverage.thresholds.branches=75 --coverage.thresholds.functions=82 --coverage.thresholds.lines=85",
    "check": "vp check"
  },
  "dependencies": {
    "lit": "^3.3.3",
    "qr-creator": "1.0.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.5",
    "happy-dom": "21.0.4",
    "vite-plus": "1.4.0",
    "vitest": "5.0.5"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vitest": "5.0.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.0.0"
    },
    "runtime": {
      "name": "node",
      "version": "^24.11.0 || >=26.0.0"
    }
  }
}
